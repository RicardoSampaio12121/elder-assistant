<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Vulnerable/deprecated packages and obsolete APIs must not slip into the build. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904;CS0618</WarningsAsErrors>
  </PropertyGroup>

</Project>
